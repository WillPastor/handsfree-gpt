<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: let scripts/e2e.sh feed a recording to voice commands and switch settings.
     DUMP is held by the adb shell but never by apps, so nothing on the phone can trigger them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".DebugAudioReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".DebugPrefsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
